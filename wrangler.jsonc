// Cloudflare Workers: the site is the files in site/, served as static assets (no Worker code), and
// nothing else in the repository is uploaded. Every push to main deploys (`npx wrangler deploy`);
// site/_headers sets the response headers.
//
// No routes here: custom domains are added in the dashboard (Settings → Domains & Routes), and
// deploys leave them there. This project's copy is at whencanistop.fyi; a copy of your own deploys
// from this file as it is.
{
  "name": "fire-simulator",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  // Every other branch (a pull request's) gets a Preview of its own: Cloudflare's builds run
  // `npx wrangler preview` there, which refuses to run without this block. Empty: a Preview is
  // the same site, with nothing of its own (it has no bindings, secrets or variables).
  "previews": {},
  // Workers Logs, readable in this account's dashboard for 3 days (7 on a paid plan). The README
  // says so under "What the host sees"; a copy that doesn't want them removes this block.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
